.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv’s dependency resolution may lead to different
#   Pipfile.lock files generated on each collaborator’s machine.
#   Thus, it might be a good idea to ignore it in these situations.
#Pipfile.lock

# PEP 582; used by e.g. pipenv
__pypackages__/

